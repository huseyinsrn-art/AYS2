{
  "name": "apt105-yonetim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/makbuz.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project ays105-test \"vitest run tests/rules.test.js\"",
    "emu": "firebase emulators:start --only firestore,auth --project ays105",
    "seed:emu": "node scripts/seed-emulator.mjs",
    "dev:emu": "vite --mode emu",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^4.3.0",
    "firebase-tools": "^15.31.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
